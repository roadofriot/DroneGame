; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited safely here.

config_version=5

[application]

config/name="MindSparQ Drone Simulator"
config/description="Physics-based 3D Drone Simulator with twin-stick flight dynamics, authored environments, and telemetry HUD."
config/version="0.1.0-alpha"
run/main_scene="res://scenes/flight/FlightWorld.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

